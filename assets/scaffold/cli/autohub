def _discover_menu_routes(drv, env):
    prefix = env.get("DB_PREFIX", "jos_")
    if not re.fullmatch(r"[A-Za-z0-9_]+", prefix):
        return []
    sql = (
        "SELECT DISTINCT CASE WHEN home=1 THEN '/' ELSE CONCAT('/', path) END "
        "FROM `%smenu` WHERE client_id=0 AND published=1 "
        "AND menutype='mainmenu' AND type IN ('component','url') "
        "AND (home=1 OR path <> '') ORDER BY 1" % prefix
    )
    r = drv.exec("db", ["sh", "-c",
        'exec mariadb -u root -p"$MARIADB_ROOT_PASSWORD" '
        '"$MARIADB_DATABASE" --batch --skip-column-names -e "$1"',
        "_", sql])
    if r.returncode != 0:
        return []
    return [line.strip() for line in (r.stdout or "").splitlines()
            if line.strip().startswith("/")]


def _route_url(base, route):
    route = route.strip()
    if not route.startswith("/"):
        route = "/" + route
    return urllib.parse.urljoin(base.rstrip("/") + "/", route.lstrip("/"))


def _sweep_page_assets(base, page_url, body):
    links = sorted(set(ASSET_LINK_RE.findall(
        body.decode("utf-8", "replace"))))
    bad = []
    base_host = urllib.parse.urlparse(base).netloc
    for raw in links:
        raw = html.unescape(raw)
        if raw.startswith(("data:", "mailto:", "javascript:")):
            continue
        asset_url = urllib.parse.urljoin(page_url, raw)
        if urllib.parse.urlparse(asset_url).netloc != base_host:
            continue
        code, _, _ = http_get(asset_url)
        if code != 200:
            bad.append("%s -> %s" % (raw, code))
    return links, bad

def cmd_verify(drv, env, args, res):
    base = drv.url()
    scope = args.scope

    if scope in ("all", "tls"):
        if drv.name == "docker":
            _inspect_local_certificate(drv.dir, env, res)
        trusted, detail = _host_https_trust(base + "/")
        res.check("HTTPS certificate trusted by host", trusted, detail)
        if not trusted and drv.name == "docker":
            res.suggest("cli/autohub tls setup --json")

    if scope in ("all", "site"):
        for path, want in [("/", 200), ("/administrator/", 200)]:
            code, _, _ = http_get(base + path)
            res.check("GET %s" % path, code == want, "HTTP %s" % code)

    if scope in ("all", "assets"):
        code, body, _ = http_get(base + "/app/cache/site/site.css")
        compiled = code == 200 and len(body) > 1000
        res.check("compiled site.css", compiled,
                  "HTTP %s, %d bytes" % (code, len(body)))
        if not compiled:
            res.suggest("cli/autohub assets build --json")
        code, _, _ = http_get(base + "/app/config/database.php")
        res.check("config is denied", code == 403, "HTTP %s (want 403)" % code)
        # Sweep every static asset linked by the homepage.
        code, body, _ = http_get(base + "/")
        if code == 200:
            links, bad = _sweep_page_assets(base, base + "/", body)
            res.check("homepage asset sweep (%d links)" % len(links),
                      not bad, "; ".join(bad[:5]))

    if scope in ("all", "components"):
        routes = [path for path, _component in CORE_COMPONENT_ROUTES]
        routes.extend(_discover_menu_routes(drv, env))
        routes.extend(getattr(args, "route", []) or [])
        seen = set()
        routes = [route for route in routes
                  if not (route in seen or seen.add(route))]
        res.say("native/menu route inventory: " + ", ".join(routes))
        for route in routes:
            url = _route_url(base, route)
            code, body, _ = http_get(url)
            usable = code == 200 and len(body) >= 200
            res.check("component route %s" % route, usable,
                      "HTTP %s, %d bytes" % (code, len(body)))
            if usable:
                links, bad = _sweep_page_assets(base, url, body)
                res.check("route assets %s (%d links)" % (route, len(links)),
                          not bad, "; ".join(bad[:5]))

    if scope in ("all", "mail"):
        r = drv.exec("web", ["bash", "-c",
                     "getent hosts \"$HUB_SMTP_HOST\" >/dev/null 2>&1 && "
                     "(exec 3<>/dev/tcp/$HUB_SMTP_HOST/$HUB_SMTP_PORT) 2>/dev/null "
                     "&& echo reachable || echo unreachable"])
        okmail = "reachable" == (r.stdout or "").strip()
        res.check("smtp reachable", okmail, (r.stdout or "").strip())
        if not okmail:
            res.say("mail failures cause 500s on core actions (group save etc.)")

    if scope in ("all", "login"):
        user = env.get("HUB_ADMIN_USER")
        pw = env.get("HUB_ADMIN_PASSWORD")
        if user and pw:
            ok, detail = _try_admin_login(base, user, pw)
            res.check("admin login", ok, detail)
        else:
            res.check("admin login", False,
                      "not run: HUB_ADMIN_USER/PASSWORD missing from .env")

    if scope in ("all", "db"):
        r = drv.exec("web", ["bash", "-c",
                     "gosu www-data php /usr/local/lib/hubzero/bootstrap-cli.php "
                     ">/dev/null 2>&1 && echo ok || echo fail"])
        res.check("app bootstrap (db reachable, config sane)",
                  "ok" == (r.stdout or "").strip())

    return res


def _classify_admin_login_page(page):
    token = re.search(r'name="([a-f0-9]{32})" value="1"', page, re.I)
    if token:
        return token.group(1), "login form and CSRF token found"
    lower = page.lower()
    if "consent" in lower and any(term in lower for term in
                                  ("privacy", "terms", "agreement", "userconsent")):
        return None, ("consent interstitial replaced the administrator login form; "
                      "configure system/userconsent or intentionally disable it for this environment")
    if 'name="username"' in lower or "com_login" in lower:
        return None, "administrator login form found, but its CSRF token was not recognized"
    return None, "administrator login form was not present in the response"


def _try_admin_login(base, user, pw):
    """End-to-end /administrator login with the CSRF token dance."""
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    import http.cookiejar
    jar = http.cookiejar.CookieJar()
    opener = urllib.request.build_opener(
        urllib.request.HTTPSHandler(context=ctx),
        urllib.request.HTTPCookieProcessor(jar))
    try:
        page = opener.open(base + "/administrator/index.php", timeout=25).read().decode("utf-8", "replace")
        token, detail = _classify_admin_login_page(page)
        if not token:
            return False, detail
        data = urllib.parse.urlencode({
            "username": user, "passwd": pw,
            "option": "com_login", "task": "login", token: "1",
        }).encode()
        opener.open(base + "/administrator/index.php", data=data, timeout=25)
        after = opener.open(base + "/administrator/index.php", timeout=25).read().decode("utf-8", "replace")
        if "task=logout" in after or "Log out" in after:
            return True, "authenticated administrator session established"
        if "invalid" in after.lower() and ("password" in after.lower() or
                                           "username" in after.lower()):
            return False, "login form rejected the configured administrator credentials"
        return False, "login submission returned without an authenticated administrator session"
    except Exception as exc:
        return False, "administrator login request failed: %s" % scrub(str(exc))


