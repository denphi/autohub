            res.fail("--json cannot be combined with the interactive database shell")
            return res
        drv.shell("db", ["sh", "-c",
            'exec mariadb -u root -p"$MARIADB_ROOT_PASSWORD" "$MARIADB_DATABASE"'])
    return res


