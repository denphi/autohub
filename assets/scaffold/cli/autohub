def find_project_dir(start):
    """Walk up until we find docker-compose.yml (the project root)."""
    d = os.path.abspath(start)
    while True:
        if os.path.isfile(os.path.join(d, "docker-compose.yml")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent


def read_env(project_dir):
    """Parse .env into a dict. Simple KEY=VALUE, ignores comments/blank."""
    env = {}
    path = os.path.join(project_dir, ".env")
    if not os.path.isfile(path):
        return env
    with open(path, encoding="utf-8", errors="replace") as stream:
        for line in stream:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, _, v = line.partition("=")
            v = v.strip().strip('"').strip("'")
            env[k.strip()] = v
    return env


def update_env(project_dir, values):
    """Update non-secret project settings without disturbing generated secrets."""
    path = os.path.join(project_dir, ".env")
    if not os.path.isfile(path):
        raise Exception("run `cli/autohub init --json` before changing project settings")
    with open(path, encoding="utf-8", errors="replace") as stream:
        text = stream.read()
    for key, value in values.items():
        line = "%s=%s" % (key, value)
        pattern = re.compile(r"^%s=.*$" % re.escape(key), re.M)
        text = pattern.sub(lambda _match: line, text) if pattern.search(text) \
            else text.rstrip() + "\n" + line + "\n"
    with open(path, "w", encoding="utf-8") as stream:
        stream.write(text)
    os.chmod(path, 0o600)


def read_autohub_config(project_dir):
    """Parse autohub.yml — the infrastructure manifest (driver selection, k8s
    settings). Absent = docker defaults. A deliberately tiny two-level parser so
    the CLI keeps its zero-dependency promise; the schema is shallow and ours.
    """
    path = os.path.join(project_dir, "autohub.yml")
    cfg = {}
    if not os.path.isfile(path):
        return cfg
    parent = None
    for raw in open(path, encoding="utf-8", errors="replace"):
        line = raw.rstrip("\n")
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        indented = line[0] in " \t"
        key, _, val = line.strip().partition(":")
        key = key.strip()
        val = val.strip().strip('"').strip("'")
        if not indented:
            if val == "":
                cfg[key] = {}
                parent = key
            else:
                cfg[key] = val
                parent = None
        elif parent is not None:
            cfg[parent][key] = val
    return cfg


SECRET_RE = re.compile(
    r"(glpat-[A-Za-z0-9._-]+|github_pat_[A-Za-z0-9_]+|gh[pousr]_[A-Za-z0-9]+|"
    r"xox[baprs]-[A-Za-z0-9-]+|(?:PASSWORD|PASS|TOKEN|SECRET)=\S+)",
    re.IGNORECASE)

def scrub(text):
    """Never let a token or password reach output or logs (R8)."""
    return SECRET_RE.sub("[redacted]", text or "")


