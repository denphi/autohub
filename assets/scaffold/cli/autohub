    if not snapshot:
        return res
    if metadata.get("target") != drv.target_id():
        res.fail("snapshot target does not match the resolved destroy target")
        return res
    r = drv.down(volumes=True)
    if r.returncode != 0:
        res.fail("destroy failed: " + scrub(r.stderr or r.stdout).strip())
        return res
    res.say("stack destroyed: managed volumes/PVCs deleted, including source, app data, database, volume-backed TLS and in-cluster backups")
    if env.get("HUB_TLS_PATH", "").startswith(("./", "../")):
        res.say("project-local TLS files were retained outside Docker volumes: "
