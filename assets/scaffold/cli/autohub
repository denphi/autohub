# driver layer
# ---------------------------------------------------------------------------

class DockerDriver:
    """Run the hub as a Docker Compose project."""

    name = "docker"

    def __init__(self, project_dir, env, dev=False):
        self.dir = project_dir
        self.env = env
        base = ["docker", "compose"]
        if dev:
            base += ["-f", "docker-compose.yml", "-f", "docker-compose.dev.yml"]
        self.compose = base

    def _run(self, args, capture=True, check=False, stdin=None, timeout=None):
        return subprocess.run(
            args, cwd=self.dir, capture_output=capture, text=True,
            check=check, input=stdin, timeout=timeout)

    def exec(self, service, cmd, stdin=None, timeout=None):
        """Run a command inside a service container (non-tty)."""
        return self._run(self.compose + ["exec", "-T", service] + cmd,
                         stdin=stdin, timeout=timeout)

    def up(self):
        return self._run(self.compose + ["up", "-d", "--build"])

    def down(self, volumes=False):
        args = self.compose + ["-f", os.path.join(self.dir, "docker-compose.yml"),
                               "-f", os.path.join(self.dir, "docker-compose.dev.yml"),
                               "down"] + (["-v"] if volumes else [])
        return self._run(args)

    def logs(self, service=None, tail=None, follow=False):
        args = self.compose + ["logs", "--no-log-prefix"]
        if tail:
            args += ["--tail", str(tail)]
        if follow:
            args += ["-f"]
        if service:
            args += [service]
        if follow:
            return self._run(args, capture=False)
        return self._run(args)

    def status(self):
        r = self._run(self.compose + ["ps", "--format", "json"])
        services = []
        for line in (r.stdout or "").splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                j = json.loads(line)
            except json.JSONDecodeError:
                continue
            services.append({
                "service": j.get("Service") or j.get("Name", ""),
                "state": j.get("State", ""),
                "health": j.get("Health", ""),
            })
        return services

    def restart(self, service):
        return self._run(self.compose + ["restart", service])

    def shell(self, service, cmd):
        """Interactive (tty) exec — inherits the terminal, no capture."""
        return subprocess.run(self.compose + ["exec", service] + cmd, cwd=self.dir)

    def stream_to_file(self, service, cmd, path):
        """Stream binary command output to a host file without buffering it."""
        with open(path, "wb") as out:
            r = subprocess.run(self.compose + ["exec", "-T", service] + cmd,
                               cwd=self.dir, stdout=out, stderr=subprocess.PIPE)
        return subprocess.CompletedProcess(r.args, r.returncode, "",
                                           r.stderr.decode("utf-8", "replace"))

    def stream_from_file(self, service, cmd, path):
        """Stream a host file to a command's stdin without putting it in argv."""
        with open(path, "rb") as src:
            r = subprocess.run(self.compose + ["exec", "-T", service] + cmd,
                               cwd=self.dir, stdin=src, capture_output=True)
        return subprocess.CompletedProcess(r.args, r.returncode,
            r.stdout.decode("utf-8", "replace"), r.stderr.decode("utf-8", "replace"))

    def target_id(self):
        project = self.env.get("COMPOSE_PROJECT_NAME", "autohub")
        return "docker:%s:%s" % (project, os.path.realpath(self.dir))

    def url(self):
        return "https://localhost:%s" % self.env.get("HTTPS_PORT", "8443")


# ---------------------------------------------------------------------------
# kubernetes driver (v2) — same interface, drives kubectl/helm instead of
# compose. Selected by `driver: kubernetes` in autohub.yml. Requires kubectl,
# helm and a reachable cluster; see deploy/chart/.
# ---------------------------------------------------------------------------

class KubernetesDriver:
    name = "kubernetes"

    # compose service name -> (kubectl workload ref, container name)
    WORKLOADS = {
        "web":  ("deployment/{rel}-web", "web"),
        "cron": ("deployment/{rel}-web", "cron"),   # cron is a sidecar in the web pod
        "db":   ("statefulset/{rel}-db", "db"),
        "mail": ("deployment/{rel}-mail", "mail"),
    }

    # .env keys that become the chart's Secret (never passed on argv)
    SECRET_KEYS = ["DB_PASSWORD", "DB_ROOT_PASSWORD", "HUB_SECRET",
                   "HUB_ADMIN_PASSWORD", "HUB_SMTP_PASSWORD"]
    # non-secret .env keys carried into the chart (hub identity/source)
    ENV_KEYS = ["HUBZERO_REPO", "HUBZERO_REF", "DB_NAME", "DB_USER", "DB_PREFIX",
                "HUB_SITENAME", "HUB_ADMIN_USER", "HUB_ADMIN_EMAIL",
                "HUB_ADMIN_NAME", "HUB_TIMEZONE"]

    def __init__(self, project_dir, env, cfg):
        self.dir = project_dir
        self.env = env
        self.cfg = cfg
        kc = cfg.get("kubernetes") if isinstance(cfg.get("kubernetes"), dict) else {}
        self.backup = cfg.get("backup") if isinstance(cfg.get("backup"), dict) else {}
        self.ns = kc.get("namespace", "autohub")
        self.rel = kc.get("release", "autohub")
        self.chart = kc.get("chart", "deploy/chart")
        self.ingress_host = kc.get("ingress_host", "")
        ctx = kc.get("context", "")
        self.context = ctx
        base = ["kubectl"] + (["--context", ctx] if ctx else [])
        self._kubectl_base = base                 # no namespace (for ns ops)
        self._kubectl = base + ["-n", self.ns]
        self._helm = ["helm"] + (["--kube-context", ctx] if ctx else []) + ["-n", self.ns]

    def _run(self, args, capture=True, stdin=None, timeout=None):
        return subprocess.run(args, cwd=self.dir, capture_output=capture,
                              text=True, input=stdin, timeout=timeout)

    def _ref(self, service):
        if service not in self.WORKLOADS:
            raise Exception("unknown service '%s' for kubernetes driver" % service)
        ref, container = self.WORKLOADS[service]
        return ref.format(rel=self.rel), container

    def exec(self, service, cmd, stdin=None, timeout=None):
        ref, container = self._ref(service)
        args = self._kubectl + ["exec", "-c", container]
        args += (["-i"] if stdin is not None else []) + [ref, "--"] + cmd
        return self._run(args, stdin=stdin, timeout=timeout)

    def _ensure_namespace(self):
        r = self._run(self._kubectl_base + ["get", "namespace", self.ns])
        if r.returncode != 0:
            self._run(self._kubectl_base + ["create", "namespace", self.ns])

    def _ensure_secret(self):
        # Apply the Secret via stdin so values never appear in argv (R8).
        lines = ["apiVersion: v1", "kind: Secret",
                 "metadata:", "  name: %s-secret" % self.rel,
                 "  namespace: %s" % self.ns, "type: Opaque", "stringData:"]
        for k in self.SECRET_KEYS:
            lines.append("  %s: %s" % (k, json.dumps(self.env.get(k, ""))))
        return self._run(self._kubectl + ["apply", "-f", "-"],
                         stdin="\n".join(lines) + "\n")

    def up(self):
        # helm is declarative + idempotent: install or converge in one call.
        self._ensure_namespace()
        s = self._ensure_secret()
        if s.returncode != 0:
            return s
        args = self._helm + ["upgrade", "--install", self.rel,
            os.path.join(self.dir, self.chart),
            "--set", "secret.existingSecret=%s-secret" % self.rel]
        manifest = os.path.join(self.dir, "hub.yml")
        if os.path.isfile(manifest):
            args += ["--set-file", "hubManifest=" + manifest]
        img = self.env.get("HUB_IMAGE", "")
        if img:
            repo, _, tag = img.partition(":")
            args += ["--set-string", "image.repository=" + repo,
                     "--set-string", "image.tag=" + (tag or "latest")]
        for k in self.ENV_KEYS:
            if self.env.get(k):
                args += ["--set-string", "env.%s=%s" % (k, self.env[k])]
        b = self.backup
        if str(b.get("enabled", "")).lower() in ("1", "true", "yes"):
            args += ["--set", "backup.enabled=true"]
            if b.get("schedule"):
                args += ["--set-string", "backup.schedule=" + str(b["schedule"])]
            if b.get("keep"):
                args += ["--set", "backup.keep=" + str(b["keep"])]
        if self.ingress_host:
            args += ["--set", "ingress.enabled=true",
                     "--set-string", "ingress.host=" + self.ingress_host]
        args += ["--wait", "--timeout", "20m"]
        return self._run(args)

    def down(self, volumes=False):
        r = self._run(self._helm + ["uninstall", self.rel])
        if volumes:
            # PVCs from a StatefulSet/Deployment are not GC'd by helm uninstall.
            self._run(self._kubectl + ["delete", "pvc", "-l",
                      "app.kubernetes.io/instance=" + self.rel])
        return r

    def logs(self, service=None, tail=None, follow=False):
        ref, container = self._ref(service or "web")
        args = self._kubectl + ["logs", ref, "-c", container]
        if tail:
            args += ["--tail", str(tail)]
        if follow:
            args += ["-f"]
            return self._run(args, capture=False)
        return self._run(args)

    def status(self):
        r = self._run(self._kubectl + ["get", "pods", "-l",
                      "app.kubernetes.io/instance=" + self.rel, "-o", "json"])
        services = []
        try:
            pods = json.loads(r.stdout or "{}").get("items", [])
        except json.JSONDecodeError:
            return services
        for p in pods:
            name = p.get("metadata", {}).get("labels", {}).get(
                "app.kubernetes.io/component") or p.get("metadata", {}).get("name", "")
            phase = p.get("status", {}).get("phase", "")
            conds = {c["type"]: c["status"] for c in p.get("status", {}).get("conditions", [])}
            ready = conds.get("Ready") == "True"
            services.append({"service": name, "state": "running" if phase == "Running" else phase,
                             "health": "healthy" if ready else "not-ready"})
        return services

    def restart(self, service):
        ref, _ = self._ref(service)
        return self._run(self._kubectl + ["rollout", "restart", ref])

    def shell(self, service, cmd):
        ref, container = self._ref(service)
        return subprocess.run(self._kubectl + ["exec", "-it", "-c", container, ref, "--"] + cmd,
                              cwd=self.dir)

    def stream_to_file(self, service, cmd, path):
        ref, container = self._ref(service)
        args = self._kubectl + ["exec", "-c", container, ref, "--"] + cmd
        with open(path, "wb") as out:
            r = subprocess.run(args, cwd=self.dir, stdout=out, stderr=subprocess.PIPE)
        return subprocess.CompletedProcess(r.args, r.returncode, "",
                                           r.stderr.decode("utf-8", "replace"))

    def stream_from_file(self, service, cmd, path):
        ref, container = self._ref(service)
        args = self._kubectl + ["exec", "-i", "-c", container, ref, "--"] + cmd
        with open(path, "rb") as src:
            r = subprocess.run(args, cwd=self.dir, stdin=src, capture_output=True)
        return subprocess.CompletedProcess(r.args, r.returncode,
            r.stdout.decode("utf-8", "replace"), r.stderr.decode("utf-8", "replace"))

    def target_id(self):
        context = self.context
        if not context:
            r = self._run(self._kubectl_base + ["config", "current-context"])
            context = (r.stdout or "").strip() or "<unknown-context>"
        return "kubernetes:%s:%s:%s" % (context, self.ns, self.rel)

    def url(self):
        if self.ingress_host:
            return "https://" + self.ingress_host
        return "https://<%s-web service>" % self.rel


def get_driver(project_dir, env, dev=False):
    cfg = read_autohub_config(project_dir)
    driver = cfg.get("driver", "docker")
    if driver == "kubernetes":
        return KubernetesDriver(project_dir, env, cfg)
    return DockerDriver(project_dir, env, dev=dev)


# ---------------------------------------------------------------------------
# result + output contract
# ---------------------------------------------------------------------------

class Result:
    def __init__(self, action):
        self.action = action
        self.ok = True
        self.details = []          # human-readable lines
        self.checks = []           # {name, ok, info}
        self.next = []             # suggested follow-up commands
        self.verify_failed = False

    def say(self, line):
        self.details.append(scrub(line))

    def check(self, name, ok, info=""):
        self.checks.append({"name": name, "ok": bool(ok), "info": scrub(str(info))})
        if not ok:
            self.verify_failed = True
        return ok

    def fail(self, line):
        self.ok = False
        self.say(line)

    def suggest(self, cmd):
        if cmd not in self.next:
            self.next.append(cmd)

    def exit_code(self):
        if not self.ok:
            return 1
        if self.verify_failed:
            return 2
        return 0

    def emit(self, as_json):
        if as_json:
            print(json.dumps({
                "ok": self.ok and not self.verify_failed,
                "action": self.action,
                "details": self.details,
                "checks": self.checks,
                "next": self.next,
            }, indent=2))
        else:
            for d in self.details:
                print(d)
            for c in self.checks:
                mark = "ok " if c["ok"] else "FAIL"
                info = ("  " + c["info"]) if c["info"] else ""
                print("  [%s] %s%s" % (mark, c["name"], info))
            if self.next:
                print("next:")
                for n in self.next:
                    print("  " + n)
        return self.exit_code()


# ---------------------------------------------------------------------------
# HTTP helpers used for application checks. Certificate trust is verified
# separately so trust failures stay distinguishable from application failures.
# ---------------------------------------------------------------------------

def http_get(url, timeout=20, headers=None):
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    req = urllib.request.Request(url, headers=headers or {})
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=ctx) as r:
            return r.status, r.read(), dict(r.headers)
    except urllib.error.HTTPError as e:
        return e.code, e.read() if e.fp else b"", dict(e.headers or {})
    except Exception as e:
        return 0, str(e).encode(), {}


# ---------------------------------------------------------------------------
# durable snapshots + destructive-operation guards
# ---------------------------------------------------------------------------

def _utc_stamp():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def _sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1024 * 1024), b""):
            h.update(block)
    return h.hexdigest()


def _require_destructive_confirmation(drv, args, res, operation):
    target = drv.target_id()
    if not getattr(args, "force", False):
        res.fail("refusing to %s without --force" % operation)
        return False
    if getattr(args, "confirm", None) != target:
        res.fail("refusing to %s: pass --confirm %s" % (operation, target))
        res.say("resolved target: " + target)
        return False
    return True


def _stream_database_dump(drv, path):
    return drv.stream_to_file("web", ["bash", "-c",
        "set -o pipefail; hub-backup - | gzip -9"], path)


def _create_snapshot(drv, env, res, label="snapshot"):
    """Create a host-side, full-state recovery point for either driver."""
    safe_label = re.sub(r"[^a-zA-Z0-9._-]+", "-", label).strip("-.") or "snapshot"
    root = os.path.join(drv.dir, "backups")
    base = os.path.join(root, "%s-%s" % (_utc_stamp(), safe_label))
    dest = base
    suffix = 1
    while os.path.exists(dest):
        dest = "%s-%d" % (base, suffix)
        suffix += 1
    os.makedirs(dest, mode=0o700)
    os.chmod(dest, 0o700)

    metadata = {
        "format": 1,
        "complete": False,
        "created_utc": _utc_stamp(),
        "target": drv.target_id(),
        "driver": drv.name,
        "files": {},
    }
    meta_path = os.path.join(dest, "metadata.json")

    source = drv.exec("web", ["git", "-C", "/var/www/html", "rev-parse", "HEAD"])
    if source.returncode == 0:
        metadata["source_commit"] = (source.stdout or "").strip()

    artifacts = [
        ("database.sql.gz", "web", ["bash", "-c",
            "set -o pipefail; hub-backup - | gzip -9"]),
        ("hub_app.tar.gz", "web", ["bash", "-c",
            "set -o pipefail; tar -czf - --exclude=app/backups --exclude=app/cache "
            "--exclude=app/logs --exclude=app/sessions -C \"$HUB_ROOT\" app"]),
        ("hub_tls.tar.gz", "web", ["bash", "-c",
            "set -o pipefail; if [ -d /etc/hubzero/tls ]; then "
            "tar -czf - -C /etc/hubzero tls; else tar -czf - --files-from /dev/null; fi"]),
    ]
    for filename, service, command in artifacts:
        path = os.path.join(dest, filename)
        r = drv.stream_to_file(service, command, path)
        if r.returncode != 0:
            metadata["error"] = "%s failed: %s" % (filename, scrub(r.stderr).strip())
            with open(meta_path, "w", encoding="utf-8") as f:
                json.dump(metadata, f, indent=2, sort_keys=True)
            res.fail("snapshot failed while creating %s; partial files kept at %s" %
                     (filename, dest))
            return None
        metadata["files"][filename] = {
            "bytes": os.path.getsize(path),
            "sha256": _sha256(path),
        }

    project = os.path.join(dest, "project")
    os.makedirs(project, mode=0o700)
    for filename in (".env", "hub.yml", "autohub.yml"):
        src = os.path.join(drv.dir, filename)
        if os.path.isfile(src):
            dst = os.path.join(project, filename)
            shutil.copy2(src, dst)
            os.chmod(dst, 0o600)
            rel = "project/" + filename
            metadata["files"][rel] = {
                "bytes": os.path.getsize(dst),
                "sha256": _sha256(dst),
            }

    metadata["complete"] = True
    with open(meta_path, "w", encoding="utf-8") as f:
        json.dump(metadata, f, indent=2, sort_keys=True)
    os.chmod(meta_path, 0o600)
    res.say("snapshot written outside managed volumes: " + dest)
    res.check("full-state snapshot", True,
              "database + hub_app + TLS + project configuration")
    return dest


def _load_snapshot(path, res):
    path = os.path.realpath(path)
    meta_path = os.path.join(path, "metadata.json")
    try:
        with open(meta_path, encoding="utf-8") as f:
            metadata = json.load(f)
    except (OSError, ValueError) as e:
        res.fail("invalid snapshot metadata: %s" % e)
        return None, None
    if not metadata.get("complete"):
        res.fail("refusing to restore an incomplete snapshot: " + path)
        return None, None
    required = {"database.sql.gz", "hub_app.tar.gz", "hub_tls.tar.gz"}
    if not required.issubset(metadata.get("files", {})):
        res.fail("snapshot is missing required full-state artifacts")
        return None, None
    for filename, expected in metadata.get("files", {}).items():
        artifact = os.path.realpath(os.path.join(path, filename))
        if os.path.commonpath([path, artifact]) != path:
            res.fail("snapshot contains an unsafe path: " + filename)
            return None, None
        if not os.path.isfile(artifact) or _sha256(artifact) != expected.get("sha256"):
            res.fail("snapshot integrity check failed: " + filename)
            return None, None
    return path, metadata


def _restore_snapshot(drv, path, metadata, res):
    source_commit = metadata.get("source_commit")
    if source_commit:
        r = drv.exec("web", ["bash", "-c",
            'set -e; HUBZERO_REF="$1" hub-source-sync --update; hub-composer; hub-config-render',
            "_", source_commit])
        if r.returncode != 0:
            res.fail("source rollback failed: " + scrub(r.stderr or r.stdout).strip())
            return False

    app = drv.stream_from_file("web", ["bash", "-c",
        'set -e; find "$HUB_ROOT/app" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +; '
        'tar -xzf - -C "$HUB_ROOT"; chown -R "$HUB_USER:$HUB_USER" "$HUB_ROOT/app"'],
        os.path.join(path, "hub_app.tar.gz"))
    if app.returncode != 0:
        res.fail("hub_app restore failed: " + scrub(app.stderr).strip())
        return False

    tls = drv.stream_from_file("web", ["bash", "-c",
        'set -e; install -d -m 700 /etc/hubzero/tls; '
        'find /etc/hubzero/tls -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +; '
        'tar -xzf - -C /etc/hubzero'],
        os.path.join(path, "hub_tls.tar.gz"))
    if tls.returncode != 0:
        res.fail("TLS restore failed: " + scrub(tls.stderr).strip())
        return False

    database = drv.stream_from_file("db", ["sh", "-c",
        'set -e; gzip -dc | exec mariadb -u"$MARIADB_USER" '
        '-p"$MARIADB_PASSWORD" "$MARIADB_DATABASE"'],
        os.path.join(path, "database.sql.gz"))
    if database.returncode != 0:
        res.fail("database restore failed: " + scrub(database.stderr).strip())
        return False

    restarted = drv.restart("web")
    if restarted.returncode != 0:
        res.fail("state restored but web restart failed: " + scrub(restarted.stderr).strip())
        return False
    res.check("full-state restore", True, os.path.basename(path))
    res.say("saved project configuration is under %s/project; review it rather than overwriting live files blindly" % path)
    res.suggest("cli/autohub verify --json")
    return True


