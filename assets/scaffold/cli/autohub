TEMPLATES_DIR = "/var/www/html/app/templates"


def _top_level_section(text, key):
    match = re.search(r"(?m)^%s:[^\n]*\n?" % re.escape(key), text)
    if not match:
        return None
    following = re.search(r"(?m)^[A-Za-z_][A-Za-z0-9_-]*:[^\n]*$",
                          text[match.end():])
    end = match.end() + following.start() if following else len(text)
    return match.start(), match.end(), end


def _upsert_local_template_manifest(text, name):
    """Register and activate a local template without requiring a YAML library."""
    text = text.rstrip() + "\n"
    ext = _top_level_section(text, "extensions")
    extension_lines = "  - type: template\n    alias: %s\n" % name
    if ext is None:
        text += "\nextensions:\n" + extension_lines
    else:
        _start, body_start, end = ext
        block = text[body_start:end]
        if not re.search(r"(?m)^\s+alias:\s*%s\s*$" % re.escape(name), block):
            text = text[:body_start] + extension_lines + text[body_start:]

    template = _top_level_section(text, "template")
    if template is None:
        text += "\ntemplate:\n  site: %s\n" % name
    else:
        start, body_start, end = template
        header = text[start:body_start]
        if re.match(r"template:\s*\{\s*\}\s*", header):
            text = text[:start] + "template:\n  site: %s\n" % name + text[end:]
        else:
            block = text[body_start:end]
            site = re.search(r"(?m)^(\s+)site:\s*[^\n]*$", block)
            if site:
                block = block[:site.start()] + site.group(1) + "site: " + name + block[site.end():]
            else:
                block = "  site: %s\n" % name + block
            text = text[:body_start] + block + text[end:]
    return text


def _create_local_template(project_dir, name):
    source = os.path.join(project_dir, "template-starter")
    target = os.path.join(project_dir, "templates", name)
    if not os.path.isdir(source):
        raise Exception("project template-starter is missing")
    if os.path.exists(target):
        raise Exception("refusing to overwrite existing template: " + target)
    os.makedirs(os.path.dirname(target), exist_ok=True)
    shutil.copytree(source, target)
    label = re.sub(r"[-_]+", " ", name).title()
    for root, _dirs, files in os.walk(target):
        for filename in files:
            path = os.path.join(root, filename)
            try:
                with open(path, encoding="utf-8") as stream:
                    text = stream.read()
            except (OSError, UnicodeError):
                continue
            text = text.replace("__TEMPLATE_NAME__", name)
            text = text.replace("__TEMPLATE_LABEL__", label)
            with open(path, "w", encoding="utf-8") as stream:
                stream.write(text)
    update_env(project_dir, {
        "LOCAL_TEMPLATE_PATH": "./templates/" + name,
        "LOCAL_TEMPLATE_NAME": name,
    })
    manifest_path = os.path.join(project_dir, "hub.yml")
    if os.path.isfile(manifest_path):
        with open(manifest_path, encoding="utf-8", errors="replace") as stream:
            manifest = stream.read()
    else:
        manifest = ""
    with open(manifest_path, "w", encoding="utf-8") as stream:
        stream.write(_upsert_local_template_manifest(manifest, name))
    return target


def _resolve_template(drv, name):
    if name:
        return name
    r = drv.exec("web", ["bash", "-c",
        'for d in %s/*/; do [ -d "$d/.git" ] && basename "$d"; done' % TEMPLATES_DIR])
    names = [n for n in (r.stdout or "").split() if n]
    if len(names) == 1:
        return names[0]
    raise Exception("pass --name; found %d template git repos: %s"
                    % (len(names), ", ".join(names) or "none"))


def cmd_template(drv, env, args, res):
    if args.name and not re.fullmatch(r"[A-Za-z0-9._-]+", args.name):
        res.fail("template name may contain only letters, digits, dot, underscore and hyphen")
        return res
    if args.sub == "create":
        if drv.name != "docker":
            res.fail("project-local template creation currently requires the Docker driver")
            return res
        if not args.name or not re.fullmatch(r"[a-z][a-z0-9_-]*", args.name):
            res.fail("template create requires --name beginning with a lowercase letter")
            return res
        target = _create_local_template(drv.dir, args.name)
        res.check("local template created", True, os.path.relpath(target, drv.dir))
        res.say("hub.yml registers and activates %s; .env mounts its project source" % args.name)
        res.suggest("cli/autohub assets lint --json")
        return res
    if args.branch and (args.branch.startswith("-") or ".." in args.branch or
                        not re.fullmatch(r"[A-Za-z0-9._/-]+", args.branch)):
        res.fail("unsafe git branch name")
        return res
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", args.token_env):
        res.fail("token environment variable name is invalid")
        return res
    name = _resolve_template(drv, args.name)
    tpl = TEMPLATES_DIR + "/" + name

    if args.sub == "status":
        script = "\n".join([
            "cd " + tpl,
            'echo "template: %s"' % name,
            'echo "branch:   $(git rev-parse --abbrev-ref HEAD)"',
            # never print an embedded token if some remote has one
            'echo "remote:   $(git remote get-url origin | sed -E \'s#oauth2:[^@]+@#oauth2:***@#\')"',
            'echo "ahead/behind (HEAD vs upstream): $(git rev-list --left-right --count @{u}...HEAD 2>/dev/null || echo n/a)"',
            'echo "uncommitted files: $(git status --porcelain | wc -l | tr -d \" \")"',
        ])
        r = drv.exec("web", ["bash", "-c", script])
        for line in scrub(r.stdout or "").splitlines():
            res.say(line)
        res.check("template repo readable", r.returncode == 0, name)
        return res

    if args.sub == "push":
        tokenenv = args.token_env
        force = "--force-with-lease" if args.force else ""
        branch = args.branch or "$(git rev-parse --abbrev-ref HEAD)"
        # Token hygiene (R8): it lives only in the container env var $tokenenv
        # (from .env). We normalise the URL to embed the *username* `oauth2`
        # (not a secret) so git prompts only for the password, which GIT_ASKPASS
        # supplies from $GITTOK. The token never touches argv, the askpass file,
        # or .git/config; the stored remote stays tokenless.
        script = "\n".join([
            "cd " + tpl + " || exit 1",
            ': "${%s:?%s is not set in the container environment (.env)}"' % (tokenenv, tokenenv),
            "BR=" + branch,
            "URL=$(git remote get-url origin | sed -E 's#https://([^@]*@)?#https://oauth2@#')",
            "AP=$(mktemp)",
            'trap \'rm -f "$AP"\' EXIT',   # remove the askpass file on any exit path
            "printf '#!/bin/sh\\necho \"$GITTOK\"\\n' > \"$AP\"",
            "chmod +x \"$AP\"",
            # exit status is git push's (the last command)
            'GITTOK="$%s" GIT_ASKPASS="$AP" git push %s "$URL" "$BR" 2>&1' % (tokenenv, force),
        ])
        r = drv.exec("web", ["bash", "-c", script])
        for line in scrub(r.stdout or "").splitlines():
            if line.strip():
                res.say(line)
        res.check("template push (%s)" % name, r.returncode == 0, name)
        if r.returncode == 0:
            res.suggest("cli/autohub assets build --json")
        return res

    return res


def cmd_update(drv, env, args, res):
