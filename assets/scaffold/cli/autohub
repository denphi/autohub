def cmd_doctor(drv, env, args, res):
    r = drv.logs(service="web", tail=args.tail)
    out = (r.stdout or "") + (r.stderr or "")
    found = 0
    for pat, advice in DOCTOR_PATTERNS:
        hits = re.findall(pat, out)
        if hits:
            found += 1
            res.check("pattern: %s" % pat[:48], False, advice)
    if not found:
        res.say("no known failure patterns in the last %d log lines" % args.tail)
    res.suggest("cli/autohub verify --json")
    if found:
        res.suggest("cli/autohub logs --errors --json")
    return res


def cmd_logs(drv, env, args, res):
    if args.follow:
        if getattr(args, "json", False):
            res.fail("--json cannot be combined with streaming --follow")
            return res
        drv.logs(service="web", follow=True)
        return res
    r = drv.logs(service="web", tail=args.tail)
    out = (r.stdout or "") + (r.stderr or "")
    if args.errors:
        # cms.ERROR lines carry the full stack trace in one (huge) line
        lines = [l for l in out.splitlines()
                 if re.search(r"cms\.ERROR|PHP Fatal|\[hub\] ERROR", l)]
        out = "\n".join(lines[-args.limit:]) if lines else "no error lines found"
    out = scrub(out)
    if getattr(args, "json", False):
        for line in out.splitlines():
            res.say(line)
    else:
        print(out)
    return res


