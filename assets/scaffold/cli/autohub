    cmd = ["hub-update"] + ([args.ref] if args.ref else [])
    r = drv.exec("web", cmd)
    res.say(scrub((r.stdout or "") + (r.stderr or "")).strip())
    res.check("update", r.returncode == 0)
    if r.returncode == 0:
