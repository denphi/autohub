def cmd_up(drv, env, args, res):
    if drv.name == "docker" and not drv.status():
        conflicts = _docker_port_conflicts(env, getattr(args, "dev", False))
        if conflicts:
            res.fail("host port preflight failed: " + ", ".join(conflicts))
            res.say("choose unused ports in .env; initialization now probes wildcard IPv4 and IPv6 bindings")
            return res
    r = drv.up()
    # up() may fail (helm error, bad compose). Surface it — the k8s path in
    # particular returns non-zero without printing to our stream.
    if r is not None and getattr(r, "returncode", 0) != 0:
        res.fail("start failed: " + scrub(((r.stderr or "") or (r.stdout or "")).strip()
                                          or "see output above"))
        return res
    res.say("stack starting")
    if args.wait:
        res.say("waiting for first-boot completion (this can take several minutes)")
        deadline = time.time() + args.timeout
        status = "timeout"
        while time.time() < deadline:
            r = drv.logs(service="web", tail=400)
            out = (r.stdout or "") + (r.stderr or "")
            if re.search(r"\[hub\] ERROR", out):
                status = "error"
                break
            if "bootstrap complete" in out:
                status = "ready"
                break
            time.sleep(10)
        if status == "ready":
            res.say("bootstrap complete")
            res.suggest("cli/autohub verify --json")
        elif status == "error":
            res.fail("bootstrap reported [hub] ERROR — see: autohub logs --errors")
        else:
            res.fail("timed out after %ss waiting for bootstrap" % args.timeout)
    else:
        res.suggest("cli/autohub up --wait --json")
        res.suggest("cli/autohub verify --json")
    return res


