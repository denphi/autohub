        command = ('gzip -dc | exec mariadb -u"$MARIADB_USER" '
                   '-p"$MARIADB_PASSWORD" "$MARIADB_DATABASE"') if path.endswith(".gz") else (
                   'exec mariadb -u"$MARIADB_USER" -p"$MARIADB_PASSWORD" "$MARIADB_DATABASE"')
        r = drv.stream_from_file("db", ["sh", "-c", command], path)
        res.check("restore", r.returncode == 0, os.path.basename(path))
        if r.returncode != 0:
            res.fail(scrub(r.stderr or "restore failed"))
        else:
            res.suggest("cli/autohub verify --json")
