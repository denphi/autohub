def build_parser():
    # Global flags live on a shared parent so they work in BOTH positions
    # (`autohub --json status` and `autohub status --json`). SUPPRESS defaults
    # keep a subparser from clobbering a value the parent already set.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help="machine-readable output")
    common.add_argument("--project-dir", default=argparse.SUPPRESS,
                        help="project root (default: auto-detect)")
    common.add_argument("--dev", action="store_true", default=argparse.SUPPRESS,
                        help="use the dev compose overlay")

    p = argparse.ArgumentParser(prog="autohub", parents=[common],
        description="Create and maintain a HUBzero hub (see DESIGN.md)")
    sub = p.add_subparsers(dest="cmd", required=True)

    def add(name, **kw):
        return sub.add_parser(name, parents=[common], **kw)

    s = add("init", help="scaffold .env + hub.yml")
    s.add_argument("--site"); s.add_argument("--preset")
    s.add_argument("--template-url"); s.add_argument("--force", action="store_true")
    s.add_argument("--confirm", help="exact target id required when --force replaces existing files")
    s.set_defaults(fn=cmd_init)

    s = add("up", help="start the stack")
    s.add_argument("--wait", action="store_true", help="block until first boot completes")
    s.add_argument("--timeout", type=int, default=900)
    s.set_defaults(fn=cmd_up)

    add("down", help="stop, keep data").set_defaults(fn=cmd_down)

    s = add("destroy", help="stop and DELETE all volumes")
    s.add_argument("--force", action="store_true")
    s.add_argument("--confirm", help="exact target id printed by `autohub status`")
    s.add_argument("--snapshot", help="validated full-state snapshot required before deletion")
    s.set_defaults(fn=cmd_destroy)

    add("status", help="service state + url").set_defaults(fn=cmd_status)
    add("provision", help="apply hub.yml").set_defaults(fn=cmd_provision)

    s = add("assets", help="template asset pipeline")
    s.add_argument("sub", choices=["build", "clean", "lint"], nargs="?", default="build")
    s.set_defaults(fn=cmd_assets)

    s = add("cache", help="compiled-css / cms cache")
    s.add_argument("sub", choices=["clear"])
    s.add_argument("--warm", action="store_true", help="request the homepage after clearing")
    s.set_defaults(fn=cmd_cache)

    s = add("verify", help="prove the hub actually works")
    s.add_argument("--scope", default="all",
                   choices=["all", "site", "assets", "components", "tls",
                            "mail", "login", "db"])
    s.add_argument("--route", action="append", default=[],
                   help="additional public route to verify; repeat as needed")
    s.set_defaults(fn=cmd_verify)

    s = add("doctor", help="match recent logs against known failures")
    s.add_argument("--tail", type=int, default=400)
    s.set_defaults(fn=cmd_doctor)

    s = add("logs", help="web logs")
    s.add_argument("--errors", action="store_true", help="only error lines")
    s.add_argument("--tail", type=int, default=300)
    s.add_argument("--limit", type=int, default=10)
    s.add_argument("--follow", action="store_true")
    s.set_defaults(fn=cmd_logs)

    s = add("db", help="database access")
    s.add_argument("sub", choices=["shell", "query", "dump", "restore"])
    s.add_argument("arg", nargs="?",
                   help="SQL for `query` (jos_ prefix), or dump file for `restore`")
    s.add_argument("--force", action="store_true",
                   help="required for `restore` (overwrites the live database)")
    s.add_argument("--confirm", help="exact target id printed by `autohub status`")
    s.set_defaults(fn=cmd_db)

    s = add("backup", help="host-side full-state snapshots")
    s.add_argument("sub", choices=["create", "restore"])
    s.add_argument("path", nargs="?", help="snapshot directory for restore")
    s.add_argument("--label", help="short label for a new snapshot")
    s.add_argument("--force", action="store_true",
                   help="required for restore (overwrites live source/app/database state)")
    s.add_argument("--confirm", help="exact target id printed by `autohub status`")
    s.set_defaults(fn=cmd_backup)

    add("migrate", help="apply pending migrations").set_defaults(fn=cmd_migrate)

    s = add("ext", help="extensions")
    s.add_argument("sub", choices=["list", "install", "enable", "disable"])
    s.add_argument("name", nargs="?")
    s.set_defaults(fn=cmd_ext)

    s = add("admin", help="create/reset an administrator")
    s.add_argument("user")
    s.set_defaults(fn=cmd_admin)

    s = add("template", help="create a local template or manage its git repo")
    s.add_argument("sub", choices=["create", "status", "push"])
    s.add_argument("--name", help="template dir under app/templates (auto if only one)")
    s.add_argument("--branch", help="branch to push (default: current)")
    s.add_argument("--token-env", default="GITLAB_TOKEN",
                   help="container env var holding the push token (default GITLAB_TOKEN)")
    s.add_argument("--force", action="store_true", help="push with --force-with-lease")
    s.set_defaults(fn=cmd_template)

    s = add("tls", help="configure or inspect browser-trusted local HTTPS")
    s.add_argument("sub", choices=["setup", "status"])
    s.add_argument("--hostname", action="append", default=[],
                   help="additional DNS name or IP for the certificate; repeat as needed")
    s.set_defaults(fn=cmd_tls)

    s = add("update", help="pull the CMS ref and migrate")
    s.add_argument("--ref")
    s.add_argument("--no-backup", action="store_true",
                   help="skip the pre-update full-state snapshot (not recommended)")
    s.add_argument("--confirm", help="exact target id required with --no-backup")
    s.set_defaults(fn=cmd_update)

    s = add("muse", help="pass a command to muse")
    s.add_argument("args", nargs=argparse.REMAINDER)
    s.set_defaults(fn=cmd_muse)

    return p


def main():
    parser = build_parser()
    args = parser.parse_args()

    # SUPPRESS defaults mean a global flag is absent unless it was passed.
    as_json = getattr(args, "json", False)
    dev = getattr(args, "dev", False)
    explicit_dir = getattr(args, "project_dir", None)

    project_dir = explicit_dir or find_project_dir(os.getcwd()) \
        or find_project_dir(os.path.dirname(os.path.abspath(__file__)))
    if not project_dir:
        message = "no docker-compose.yml found (use --project-dir)"
        if as_json:
            print(json.dumps({"ok": False, "action": getattr(args, "cmd", ""),
                              "details": [message], "checks": [], "next": []}, indent=2))
        else:
            print("error: " + message, file=sys.stderr)
        sys.exit(3)

    env = read_env(project_dir)
    drv = get_driver(project_dir, env, dev=dev)
    res = Result(args.cmd)
    try:
        args.fn(drv, env, args, res)
    except KeyboardInterrupt:
        sys.exit(130)
    except Exception as e:  # a crash must still honor the output contract
        res.fail("internal error: %s" % scrub(str(e)))
    sys.exit(res.emit(as_json))


if __name__ == "__main__":
    main()
