CSS_MATH_RE = re.compile(r"(?<![-\w])(min|max)\s*\(([^)]*)\)", re.I)
CSS_UNIT_RE = re.compile(
    r"(?:\d|\.)\s*(%|px|rem|em|vh|vw|vmin|vmax)(?![A-Za-z])", re.I)


def _lint_less_text(text):
    """Find mixed-unit CSS math that legacy LesserPHP tries and fails to evaluate."""
    issues = []
    for match in CSS_MATH_RE.finditer(text):
        units = {unit.lower() for unit in CSS_UNIT_RE.findall(match.group(2))}
        if len(units) > 1:
            line = text.count("\n", 0, match.start()) + 1
            issues.append((line, "%s() mixes units %s" %
                           (match.group(1), ", ".join(sorted(units)))))
    return issues


def _local_template_dirs(project_dir, env):
    candidates = []
    configured = env.get("LOCAL_TEMPLATE_PATH", "")
    if configured:
        candidates.append(configured if os.path.isabs(configured)
                          else os.path.join(project_dir, configured))
    root = os.path.join(project_dir, "templates")
    if os.path.isdir(root):
        candidates.extend(os.path.join(root, name) for name in os.listdir(root))
    found = []
    for path in candidates:
        path = os.path.realpath(path)
        if os.path.isdir(path) and path not in found:
            found.append(path)
    return found


def _lint_project_less(project_dir, env):
    issues = []
    for template in _local_template_dirs(project_dir, env):
        for root, _dirs, files in os.walk(template):
            for filename in files:
                if not filename.endswith(".less"):
                    continue
                path = os.path.join(root, filename)
                with open(path, encoding="utf-8", errors="replace") as stream:
                    text = stream.read()
                for line, detail in _lint_less_text(text):
                    issues.append("%s:%d: %s" %
                                  (os.path.relpath(path, project_dir), line, detail))
    return issues


def cmd_assets(drv, env, args, res):
    issues = _lint_project_less(drv.dir, env)
    res.check("legacy LESS preflight", not issues,
              "; ".join(issues[:5]) if issues else "local LESS syntax is compatible")
    if issues:
        res.say("replace mixed-unit min()/max() with width plus min/max-width or height constraints")
        return res
    if args.sub == "lint":
        return res
    # hub-assets [--clean]: no arg = compile only; --clean = clear then recompile
    cmd = ["hub-assets"] + (["--clean"] if args.sub == "clean" else [])
    r = drv.exec("web", cmd)
    out = (r.stdout or "") + (r.stderr or "")
