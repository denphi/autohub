# Copy to .env and edit. Everything here is consumed by docker-compose.yml.
#
#   cp .env.example .env && make up

# --- Source ----------------------------------------------------------------
# Unique per initialized project. Prevents unrelated AutoHub directories from
# sharing Compose volumes, networks, containers, or stale database credentials.
COMPOSE_PROJECT_NAME=autohub

# Any branch, tag or commit sha in HUBZERO_REPO. Change it and run `make update`
# to move a running hub; no image rebuild is involved.
HUBZERO_REPO=https://github.com/hubzero/hubzero-cms.git
HUBZERO_REF=2.4-main

# Fetch and fast-forward on every container start. Leave 0 for production and
# use an explicit `make update` instead.
HUBZERO_AUTO_UPDATE=0

# --- Database --------------------------------------------------------------
DB_NAME=hubzero
DB_USER=hubzero
# Required, and must not be empty: HUBzero reads a blank database password as
# "not configured yet" and redirects the whole site to /install.
DB_PASSWORD=change-me-hubzero
DB_ROOT_PASSWORD=change-me-root
DB_PREFIX=jos_

# --- Site ------------------------------------------------------------------
HTTP_PORT=8080
# HUBzero's admin login hardcodes a redirect to https (com_login has no setting
# for it), so the hub is unusable without TLS. Run `cli/autohub tls setup` for
# trusted local HTTPS. A self-signed certificate is generated only as fallback.
HTTPS_PORT=8443
HUB_TLS_CN=localhost
# `autohub tls setup` changes this to ./.autohub/tls after issuing a
# browser-trusted local certificate. Keep hub_tls only for the self-signed
# fallback, or set an operator-managed absolute certificate directory in
# production.
HUB_TLS_PATH=hub_tls
HUB_TLS_MODE=self-signed
HUB_SITENAME=AutoHub
# development | testing | staging | production
HUB_ENV=production
HUB_DEBUG=0

# none | simple | relaxed | maximum | default
#
# Keep this at "none" unless you are debugging. HUBzero's error handler turns
# *any* PHP warning into a fatal rendered error page, and 2.4.1 still emits
# warnings on PHP 8 -- com_content's featured-articles view reads an array key
# it only conditionally sets, so the stock front page 500s at any other level.
# Warnings are logged to app/logs either way: the handler logs first and only
# then decides whether to die, so "none" costs no visibility.
HUB_ERROR_REPORTING=none
HUB_TIMEZONE=UTC
HUB_FORCE_SSL=0
# Absolute public URL. Leave empty to let the app detect it from the request.
HUB_LIVE_SITE=
# Signs sessions and password-reset tokens. Generated and persisted on first
# boot if left empty. Set it explicitly when running more than one web replica.
HUB_SECRET=

# --- First administrator ---------------------------------------------------
# Used once, while the database is still empty. Afterwards, manage accounts in
# the admin UI or with `make admin USER=... PASS=...`.
HUB_ADMIN_USER=admin
HUB_ADMIN_PASSWORD=
HUB_ADMIN_EMAIL=admin@example.com
HUB_ADMIN_NAME=Administrator

# Load HUBzero's demo content alongside the schema.
HUB_LOAD_SAMPLE_DATA=0

# --- Project-local template ------------------------------------------------
# `autohub template create --name <alias>` updates these values. The default
# mounts the inert starter at an unused alias until a local template is created.
LOCAL_TEMPLATE_PATH=./template-starter
LOCAL_TEMPLATE_NAME=autohub-local

# --- Component content imports --------------------------------------------
# Files referenced by resources/publications are resolved only beneath this
# read-only project directory, validated, then copied into native storage.
HUB_CONTENT_PATH=./content
# Per-file import ceiling; the runtime also applies component safety checks.
HUB_CONTENT_MAX_BYTES=40000000

# --- Mail ------------------------------------------------------------------
# mail | smtp | sendmail
HUB_MAILER=smtp
HUB_MAIL_FROM=hub@example.com
HUB_MAIL_FROMNAME=AutoHub
HUB_SMTP_HOST=mail
HUB_SMTP_PORT=1025
# none | ssl | tls
HUB_SMTP_SECURE=none
HUB_SMTP_AUTH=0
HUB_SMTP_USER=
HUB_SMTP_PASSWORD=

# --- Scheduled jobs --------------------------------------------------------
HUB_CRON_INTERVAL=60

# --- Development overlay only ----------------------------------------------
# Host path to the checkout served by `make dev`.
HUB_SOURCE_PATH=./hubzero-cms
DB_PORT=3306
ADMINER_PORT=8081
MAILPIT_PORT=8025

# --- Secrets referenced by hub.yml -----------------------------------------
# hub.yml is meant to be committed, so any token it needs is written there as
# ${VAR} and resolved from here.
GITLAB_TOKEN=
TEST_USER_PASSWORD=

# --- Escape hatch ----------------------------------------------------------
# Any HUBCFG_<group>__<key> variable is written straight into
# app/config/<group>.php, for settings without a dedicated variable above:
#   HUBCFG_app__list_limit=50
#   HUBCFG_session__lifetime=120
